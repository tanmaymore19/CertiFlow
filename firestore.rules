rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'tanmaymore0220@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for Project
    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'name', 'status'])
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.status in ['draft', 'ready', 'processing', 'completed', 'failed']
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('recipientCount' in data) || data.recipientCount is number)
        && (!('generatedCount' in data) || data.generatedCount is number)
        && (!('failedCount' in data) || data.failedCount is number);
    }

    // Validation for Recipient
    function isValidRecipient(data) {
      return data.keys().hasAll(['projectId', 'userId', 'status'])
        && data.projectId is string && data.projectId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.status in ['pending', 'success', 'failed']
        && (!('generatedFileName' in data) || (data.generatedFileName is string && data.generatedFileName.size() <= 255))
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 500));
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(projectId) && isSignedIn()
        && incoming().userId == request.auth.uid
        && isValidProject(incoming());
      allow update: if isValidId(projectId) && isSignedIn()
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().userId == existing().userId))
        && isValidProject(incoming());
      allow delete: if isValidId(projectId) && isSignedIn()
        && (isAdmin() || existing().userId == request.auth.uid);

      // Subcollection for recipients
      match /recipients/{recipientId} {
        allow get: if isValidId(recipientId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
        allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isValidId(recipientId) && isSignedIn()
          && incoming().userId == request.auth.uid
          && incoming().projectId == projectId
          && isValidRecipient(incoming())
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        allow update: if isValidId(recipientId) && isSignedIn()
          && (isAdmin() || (existing().userId == request.auth.uid && incoming().userId == existing().userId))
          && isValidRecipient(incoming());
        allow delete: if isValidId(recipientId) && isSignedIn()
          && (isAdmin() || existing().userId == request.auth.uid);
      }
    }
  }
}
